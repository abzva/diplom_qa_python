BROWSERSTACK_USERNAME=replace_me
BROWSERSTACK_ACCESS_KEY=replace_me
BROWSERSTACK_APP_URL=bs://replace_after_upload
BROWSERSTACK_DEVICE_NAME=replace_after_device_selection
BROWSERSTACK_PLATFORM_VERSION=replace_after_device_selection

# Remote UI is enabled only by --ui-mode=selenoid. Get real values from QA.GURU.
# Exact WebDriver endpoint (including its path); installed Chrome version;
# video directory URL, including /video/ or the course-specific route.
# Bare host uses HTTPS and /wd/hub; an existing path is preserved.
# Legacy WEBDRIVER_URL/USERNAME/PASSWORD names are accepted; avoid conflicting values.
SELENOID_URL=
SELENOID_BROWSER_VERSION=
SELENOID_VIDEO_BASE_URL=
# Optional HTTP Basic Auth pairs. Empty means no authentication.
SELENOID_LOGIN=
SELENOID_PASS=
# Video authentication is explicit and independent; never inherited from hub.
SELENOID_VIDEO_USERNAME=
SELENOID_VIDEO_PASSWORD=
